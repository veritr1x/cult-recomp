+void mci_close() {
+    if (!mci.alias.empty()) {
+        host_midi_reset();
+        host_midi_close();
+    }
+    mci = {};
+}
+void mci_pump() {
+    if (!mci.playing)
+        return;
+    uint32_t now = host_millis();
+    uint64_t advance = uint64_t(uint32_t(now - mci.last_ms)) * 1000;
+    mci.elapsed += std::min(advance, mci.duration - mci.elapsed);
+    mci.last_ms = now;
+    uint32_t budget = 4096;
+    while (mci.next < mci.events.size() && mci.events[mci.next].us <= mci.elapsed && budget--) {
+        mci_event(mci.events[mci.next++]);
+    }
+    if (mci.next == mci.events.size()) {
+        mci.playing = false;
+        host_midi_reset();
+    }
+}
+std::string command_lower(std::string text) {
+    for (char &ch : text)
+        if (ch >= 'A' && ch <= 'Z')
+            ch += 'a' - 'A';
+    return text;
+}
+bool command_words(const std::string &command, std::vector<std::string> &words) {
+    size_t at = 0;
+    while (at < command.size()) {
+        if (command[at] == ' ' || command[at] == '\t') {
+            ++at;
+            continue;
+        }
+        size_t begin = at;
+        if (command[at] == '"') {
+            begin = ++at;
+            at = command.find('"', at);
+            if (at == std::string::npos)
+                return false;
+            words.push_back(command.substr(begin, at++ - begin));
+            if (at < command.size() && command[at] != ' ' && command[at] != '\t')
+                return false;
+        } else {
+            while (at < command.size() && command[at] != ' ' && command[at] != '\t')
+                ++at;
+            words.push_back(command.substr(begin, at - begin));
+        }
+        if (words.size() > 16)
+            return false;
+    }
+    return !words.empty();
+}
