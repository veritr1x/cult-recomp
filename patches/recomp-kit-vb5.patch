+static void test_wide_string_comparison() {
+    section("wide string comparison");
+    X86 c = *loader_context();
+    uint32_t a = scratch, b = scratch + 512;
+    gm_put_wstr(a, "Runtime", 64);
+    gm_put_wstr(b, "runtime", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpiW", {a, b}) == 0,
+          "lstrcmpiW ignores ASCII case and pops two arguments");
+    check((int32_t)call_import(&c, "KERNEL32.dll", "lstrcmpW", {a, b}) < 0,
+          "lstrcmpW preserves case");
+    gm_put_wstr(a, "\xc3\x89", 64);
+    gm_put_wstr(b, "\xc3\xa9", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpiW", {a, b}) == 0,
+          "lstrcmpiW folds Latin-1 letters");
+    wr16(a, 0x0141);
+    wr16(a + 2, 0);
+    wr16(b, 0x0041);
+    wr16(b + 2, 0);
+    check((int32_t)call_import(&c, "KERNEL32.dll", "lstrcmpiW", {a, b}) > 0,
+          "wide comparison retains the high byte of UTF-16 units");
+    gm_put_wstr(a, "a", 64);
+    gm_put_wstr(b, "ab", 64);
+    check((int32_t)call_import(&c, "KERNEL32.dll", "lstrcmpiW", {a, b}) < 0,
+          "a string sorts before a longer string with the same prefix");
+    gm_put_wstr(a, "", 64);
+    gm_put_wstr(b, "", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpW", {a, b}) == 0,
+          "empty wide strings compare equal");
+    gm_put_str(a, "Picture.OCX", 64);
+    gm_put_str(b, "picture.ocx", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpiA", {a, b}) == 0,
+          "ANSI comparison folds ASCII DLL names with a two-argument ABI");
+    gm_put_str(a, "\xc9", 64);
+    gm_put_str(b, "\xe9", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpiA", {a, b}) == 0,
+          "ANSI comparison folds Latin-1 letters in Windows-1252");
+    gm_put_str(a, "\x8a\x8c\x8e\x9f", 64);
+    gm_put_str(b, "\x9a\x9c\x9e\xff", 64);
+    check(call_import(&c, "KERNEL32.dll", "lstrcmpiA", {a, b}) == 0,
+          "ANSI comparison folds extended Windows-1252 letter pairs");
+    gm_put_str(a, "A", 64);
+    gm_put_str(b, "ab", 64);
+    check(int32_t(call_import(&c, "KERNEL32.dll", "lstrcmpiA", {a, b})) < 0,
+          "case-insensitive ANSI ordering retains a shorter matching prefix");
+}
