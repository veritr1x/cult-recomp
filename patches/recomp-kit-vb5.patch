+          "GetClassInfoA returns WNDCLASS fields at their x86 offsets");
+    check(call_import(&c, "USER32.dll", "GetClassInfoExA", {IMAGE_BASE, s, info}) == 1 &&
+              rd32(info) == 48 && rd32(info + 4) == 0x23 && rd32(info + 16) == 16 &&
+              rd32(info + 48) == 0x5a5a5a5a,
+          "GetClassInfoExA shifts fields after cbSize without overflowing WNDCLASSEX");
+    call_import(&c, "USER32.dll", "UnregisterClassA", {s, IMAGE_BASE});
+    for (uint32_t m = 0; m < loader_module_count(); ++m) {
