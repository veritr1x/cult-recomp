+    wr32(clsid, 0x11223344);
+    wr16(clsid + 4, 0x5566);
+    wr16(clsid + 6, 0x7788);
+    const uint8_t tail[] = {0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff, 0};
