+    call_import(&c, "USER32.dll", "SetWindowLongW", {hwnd, uint32_t(-16), 0x10000000});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 1});
+    dc = call_import(&c, "USER32.dll", "BeginPaint", {hwnd, ps});
+    check(call_import(&c, "USER32.dll", "GetUpdateRect", {child, 0, 0}) != 0,
+          "unclipped parent erasure schedules visible children to repaint");
+    call_import(&c, "USER32.dll", "EndPaint", {hwnd, ps});
+    call_import(&c, "USER32.dll", "UpdateWindow", {child});
+    dc = call_import(&c, "USER32.dll", "GetDC", {hwnd});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 8, 2}) == 0xff,
+          "child paint restores its own pixels after parent erasure");
+    call_import(&c, "USER32.dll", "ReleaseDC", {hwnd, dc});
+    call_import(&c, "USER32.dll", "DestroyWindow", {hwnd});
+    call_import(&c, "GDI32.dll", "DeleteObject", {brush});
+    call_import(&c, "GDI32.dll", "DeleteObject", {red});
