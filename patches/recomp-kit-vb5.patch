+              call_import(&c, "OLEAUT32.dll", "SysStringByteLen", {b}) == 3,
+          "SysAllocStringByteLen preserves odd byte counts, embedded NULs and termination");
+    uint32_t src = s + 64, dst = s + 80;
+    memset(g_mem + src, 0, 32);
+    wr16(src, 8);
+    wr32(src + 8, b);
+    check(call_import(&c, "OLEAUT32.dll", "VariantCopy", {dst, src}) == 0 &&
+              rd32(rd32(dst + 8) - 4) == 3 && rd8(rd32(dst + 8) + 2) == 0x42,
+          "VariantCopy preserves all bytes of a binary BSTR");
+    call_import(&c, "OLEAUT32.dll", "VariantClear", {src});
+    call_import(&c, "OLEAUT32.dll", "VariantClear", {dst});
+
+    uint32_t a = call_import(&c, "ole32.dll", "CoTaskMemAlloc", {32});
+    memset(g_mem + a, 0, 32);
+    wr16(a, 2);
+    wr32(a + 4, 4);
+    wr32(a + 16, 2);
+    wr32(a + 20, uint32_t(-1));
+    wr32(a + 24, 3);
+    wr32(a + 28, 5);
+    check(call_import(&c, "OLEAUT32.dll", "ord37", {a}) == 0 && rd32(a + 12) != 0,
+          "SafeArrayAllocData accepts a caller-created two-dimensional descriptor");
+    uint32_t data = rd32(a + 12);
+    check(heap_size(data) == 24 && rd32(data) == 0 && rd32(data + 20) == 0,
+          "array storage has the product of the bounds and is zero initialized");
+    wr32(a + 8, 1);
+    check(call_import(&c, "OLEAUT32.dll", "SafeArrayDestroyData", {a}) == 0x8002000du &&
+              call_import(&c, "OLEAUT32.dll", "SafeArrayDestroyDescriptor", {a}) == 0x8002000du &&
+              heap_owns(a) && heap_owns(data),
+          "locked arrays retain both their descriptor and data");
+    wr32(a + 8, 0);
+    check(call_import(&c, "OLEAUT32.dll", "SafeArrayDestroyData", {a}) == 0 && !heap_owns(data) &&
+              heap_owns(a) && rd32(a + 12) == 0,
+          "DestroyData releases only the elements and clears pvData");
+    check(call_import(&c, "OLEAUT32.dll", "ord38", {a}) == 0 && !heap_owns(a),
+          "DestroyDescriptor releases the descriptor separately");
+    a = s + 128;
+    memset(g_mem + a, 0, 24);
+    wr16(a, 1);
+    wr16(a + 2, 4);
+    wr32(a + 4, 1);
+    wr32(a + 16, 3);
+    check(call_import(&c, "OLEAUT32.dll", "SafeArrayAllocData", {a}) == 0 &&
+              call_import(&c, "OLEAUT32.dll", "SafeArrayDestroy", {a}) == 0 && rd16(a) == 1,
+          "an embedded descriptor survives destruction of its allocated data");
+    a = call_import(&c, "ole32.dll", "CoTaskMemAlloc", {24});
+    memset(g_mem + a, 0, 24);
+    wr16(a, 1);
+    wr32(a + 4, 1);
+    wr32(a + 16, 4);
+    wr32(a + 12, call_import(&c, "ole32.dll", "CoTaskMemAlloc", {4}));
+    data = rd32(a + 12);
+    check(call_import(&c, "OLEAUT32.dll", "SafeArrayDestroyDescriptor", {a}) == 0 &&
+              heap_owns(data),
+          "DestroyDescriptor does not release the data allocation");
+    call_import(&c, "ole32.dll", "CoTaskMemFree", {data});
+}
