+
+
+def test_unreached_prefix_cannot_branch_to_a_pruned_tail():
+    listing = ("00401100  TEST EAX,EAX\n"
+               "00401102  JNZ 0x00401120\n"
+               "00401110  CALL 0x00401000\n"
+               "00401120  MOV EAX,0x1\n"
+               "00401125  JMP 0x00401110\n")
+    fn = T.Function(0x00401110, "entry_in_middle", 0x20, T.parse_listing_text(listing))
+    fn.measure(NoImage())
+    tr = T.Translator(NoImage(), {fn.addr, HALT}, Opts())
+    tr.noreturn_callees = {HALT}
+    tr.prepare(fn)
+    text = "\n".join(tr.translate(fn))
+    assert "00401100" not in text and "00401102" not in text
+    assert "goto L_00401120" not in text
+
+
+def test_disconnected_island_cannot_branch_to_a_pruned_tail():
+    listing = ("00401100  JMP 0x00401110\n"
+               "00401105  JNZ 0x00401120\n"
+               "00401110  CALL 0x00401000\n"
+               "00401120  MOV EAX,0x1\n"
+               "00401125  RET\n")
+    text = translate(listing)
+    assert "00401105" not in text and "goto L_00401120" not in text
