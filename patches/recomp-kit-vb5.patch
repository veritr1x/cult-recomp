+    uint32_t edit = call_import(&c, "USER32.dll", "CreateWindowExA",
+                                {0, s, 0, 0x10000000, 0, 0, 160, 24, 0, 0, 0, 0});
+    check(edit != 0, "Edit creation accepts WM_NCCREATE and WM_CREATE");
+    auto msg = [&](uint32_t message, uint32_t wp = 0, uint32_t lp = 0) {
+        return call_import(&c, "USER32.dll", "SendMessageA", {edit, message, wp, lp});
+    };
+    auto text = [&]() {
+        msg(0xd, 64, s + 320);
+        return gm_str(s + 320);
+    };
+    gm_put_str(s + 256, "save001", 32);
+    check(msg(0xc, 0, s + 256) == 1 && text() == "save001" && msg(0xe) == 7 && msg(0xb8) == 0,
+          "WM_SETTEXT owns the text and clears its modification state");
+    msg(0xb1, 7, 4);
+    check(msg(0xb0, s + 384, s + 388) == 0x00070004u && rd32(s + 384) == 4 && rd32(s + 388) == 7,
+          "reversed selection reports ordered TCHAR indices");
+    gm_put_str(s + 256, "ABC", 32);
+    msg(0xc2, 1, s + 256);
+    check(text() == "saveABC" && msg(0xb8) == 1 && msg(0xc6) == 1 && msg(0xb0) == 0x00070007u,
+          "replacement owns its text, moves the caret and creates undo state");
+    check(msg(0xc7) == 1 && text() == "save001", "Undo restores the previous owned text");
+    msg(0xcd);
+    check(msg(0xc6) == 0, "EM_EMPTYUNDOBUFFER clears undo ownership");
+    msg(0xc5, 3);
+    check(msg(0xd5) == 3, "EM_GETLIMITTEXT reports the typing limit");
+    msg(0xb1, 0, 0xffffffff);
+    msg(0x102, 'A');
+    msg(0x102, 'B');
+    msg(0x102, 'C');
+    msg(0x102, 'D');
+    check(text() == "ABC", "typed text replaces selection and stops at the requested limit");
+    msg(0x102, 8);
+    check(text() == "AB", "Backspace deletes text before the caret");
+    msg(0xcf, 1);
+    msg(0x102, 'Z');
+    check(text() == "AB", "read-only state rejects user typing");
+    msg(0xcf, 0);
+    msg(0x102, 'Z');
+    check(text() == "ABZ", "clearing read-only state restores typing");
+    gm_put_str(s + 256, "longer than three", 32);
+    msg(0xc, 0, s + 256);
+    check(text() == "longer than three", "WM_SETTEXT is independent of the user typing limit");
+    msg(0xcc, '*');
+    check(msg(0xd2) == '*' && text() == "longer than three",
+          "password masking preserves the underlying text");
+    msg(0xd3, 3, (7u << 16) | 5u);
+    check(msg(0xd4) == 0x00070005u && msg(0xb2, 0, s + 384) == 0 && rd32(s + 384) == 5 &&
+              rd32(s + 392) == 153,
+          "Edit margins change the measured formatting rectangle");
+    call_import(&c, "USER32.dll", "DestroyWindow", {edit});
