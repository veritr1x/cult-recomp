+constexpr uint32_t INVALID = 0x80030057u, POINTER = 0x80030009u;
+constexpr uint32_t INVALIDFUNCTION = 0x80030001u, NOTFOUND = 0x80030002u;
+constexpr uint32_t DENIED = 0x80030005u, EXISTS = 0x80030050u;
+constexpr uint32_t OOM = 0x80030008u, INVALIDNAME = 0x800300fcu;
+constexpr uint32_t MAX_STREAM = 64u * 1024 * 1024;
+struct Bytes {
+    std::vector<uint8_t> data;
+    std::u16string name;
+    bool live = true;
+    uint32_t global = 0, global_size = 0;
+    bool memory_stream = false, delete_global = false;
+    size_t size() const {
+        return memory_stream ? global_size : data.size();
+    }
+    uint8_t *ptr() {
+        return memory_stream ? g_mem + global : data.data();
+    }
+    ~Bytes() {
+        if (delete_global && global)
+            heap_free(global);
+    }
+};
+struct Storage {
+    uint32_t refs = 1, mode = 0, state = 0;
+    std::array<uint8_t, 16> clsid{};
+    std::map<std::u16string, std::shared_ptr<Bytes>> streams;
+};
+struct Stream {
+    uint32_t refs = 1, mode = 0;
+    uint64_t position = 0;
+    std::shared_ptr<Bytes> bytes;
+};
+std::map<uint32_t, Storage> storages;
+std::map<uint32_t, Stream> streams;
