+    uint32_t original = call_import(&c, "GDI32.dll", "GetCurrentObject", {dc, 7});
+    uint32_t bitmap = call_import(&c, "GDI32.dll", "CreateCompatibleBitmap", {dc, 2, 3});
+    check(dc && original && bitmap &&
+              call_import(&c, "GDI32.dll", "SelectObject", {dc, bitmap}) == original &&
+              call_import(&c, "GDI32.dll", "GetCurrentObject", {dc, 7}) == bitmap,
+          "GetCurrentObject follows the bitmap selected into the DC");
+    call_import(&c, "GDI32.dll", "SelectObject", {dc, original});
+    check(call_import(&c, "GDI32.dll", "GetCurrentObject", {dc, 7}) == original &&
+              call_import(&c, "GDI32.dll", "GetCurrentObject", {0, 7}) == 0 &&
+              call_import(&c, "GDI32.dll", "GetCurrentObject", {dc, 99}) == 0,
+          "the default bitmap is restored and invalid queries fail");
+    call_import(&c, "GDI32.dll", "DeleteObject", {bitmap});
+    call_import(&c, "GDI32.dll", "DeleteDC", {dc});
+
+    uint32_t wc = s + 512, info = s + 640;
+    gm_put_str(s, "StartupFixtureClass", 64);
+    memset(g_mem + wc, 0, 40);
