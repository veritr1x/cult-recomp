+        if (current != siblings.end()) {
+            auto first = current;
+            while (first != siblings.begin() && !(find_window(*first)->style & 0x20000))
+                --first;
+            auto last = current + 1;
+            while (last != siblings.end() && !(find_window(*last)->style & 0x20000))
+                ++last;
+            for (auto i = first; i != last; ++i)
+                if (Window *radio = find_window(*i); (radio->style & 15) == 9)
+                    radio->button_check = *i == hwnd;
+        }
+    }
+    w->button_pressed = false;
+    w->update_pending = true;
