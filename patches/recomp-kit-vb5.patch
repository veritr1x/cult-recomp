+bool win32_attach_static_imports(X86 *c, const LoaderModule &m) {
+    // The loader has already validated and bound this PE's import directory.
+    // Marking a DLL attached before descending breaks cyclic dependencies;
+    // its DllMain still runs only after its dependencies have initialized.
+    const uint32_t saved_eax = c->r[R_EAX], saved_eip = c->eip;
+    auto in_image = [&m](uint32_t offset, uint32_t bytes) {
+        return offset < m.size && bytes <= m.size - offset;
+    };
+    if (!in_image(0x3c, 4))
+        return false;
+    uint32_t pe = rd32(m.base + 0x3c);
+    if (!in_image(pe, 24 + 112))
+        return false;
+    uint32_t imports = rd32(m.base + pe + 24 + 104);
+    for (uint32_t d = imports; imports && in_image(d, 20); d += 20) {
+        uint32_t name_rva = rd32(m.base + d + 12);
+        if (!name_rva)
+            break;
+        if (!in_image(name_rva, 1))
+            return false;
+        std::string name = gm_str(m.base + name_rva, 260);
+        if (LoaderModule *dependency = loader_module_named(name.c_str())) {
+            if (dependency->base == loader_image_base())
+                continue;
+            load_library_named(c, name);
+            bool ok = c->r[R_EAX] != 0;
+            c->r[R_EAX] = saved_eax;
+            c->eip = saved_eip;
+            if (!ok)
+                return false;
+        }
+    }
+    c->r[R_EAX] = saved_eax;
+    c->eip = saved_eip;
+    return true;
+}
