+++ b/runtime/user32_listbox.cpp
@@ -0,0 +1,438 @@
+// The system LISTBOX procedure remains callable through framework subclasses.
+// Item strings and selection belong to the window, so destruction releases
+// them. Parent notifications may destroy the control: copy state first and
+// never retain a Window pointer across a guest callback.
+#include "user32_internal.h"
+#include "memory.h"
+#include <algorithm>
+#include <cctype>
+#include <climits>
+
+namespace user32 {
+namespace {
+constexpr uint32_t ERROR = 0xffffffffu;
+bool multiple(const Window &w) {
+    return (w.style & 0x808) != 0;
+}
+bool has_strings(const Window &w) {
+    return !(w.style & 0x30) || (w.style & 0x40);
+}
+bool index(const Window &w, uint32_t n) {
+    return n < w.list_items.size();
+}
+std::string folded(std::string s) {
+    for (char &ch : s)
+        if (uint8_t(ch) < 128)
+            ch = char(std::tolower(uint8_t(ch)));
+    return s;
+}
+void notify(X86 *c, uint32_t hwnd, uint32_t code) {
+    Window *w = find_window(hwnd);
+    if (w && (w->style & 1) && w->parent) {
+        uint32_t parent = w->parent, id = w->id;
+        host_dispatch_to_wndproc(c, parent, 0x111, (code << 16) | (id & 0xffff), hwnd);
+    }
+}
+void select(Window &w, int32_t n) {
+    w.list_selection = n;
+    if (n >= 0)
+        w.list_caret = n;
+    for (size_t i = 0; i < w.list_items.size(); ++i)
+        w.list_items[i].selected = int32_t(i) == n;
+    w.update_pending = true;
+}
+int32_t column_rows(const Window &w) {
+    return std::max(1, w.h / int32_t(std::max(1u, w.list_item_height)));
+}
+void paint(X86 *c, uint32_t hwnd, uint32_t into) {
+    Window *w = find_window(hwnd);
+    if (!w)
+        return;
+    if (!into)
+        w->update_pending = false;
+    const uint32_t font = w->font, parent = w->parent;
+    const int32_t width = w->w, height = w->h, top = w->list_top;
+    const uint32_t row_height = std::max(1u, w->list_item_height);
+    const bool columns = (w->style & 0x200) != 0;
+    const int32_t column_width = columns ? int32_t(std::max(1u, w->list_column_width)) : width;
+    const int32_t rows = column_rows(*w);
+    const uint64_t capacity =
+        columns
+            ? uint64_t(rows) * ((uint64_t(std::max(0, width)) + column_width - 1) / column_width)
+            : (uint64_t(std::max(0, height)) + row_height - 1) / row_height;
+    // Snapshot text and highlight state before WM_CTLCOLORLISTBOX.
+    std::vector<ListItem> visible;
+    for (int32_t n = top;
+         n >= 0 && size_t(n) < w->list_items.size() && uint64_t(n - top) < capacity; ++n)
+        visible.push_back(w->list_items[size_t(n)]);
+    uint32_t dc = into ? into : gdi_window_dc(hwnd);
+    auto *state = gdi::dc_of(dc);
+    if (!state)
+        return;
+    uint32_t old_font = state->font;
+    if (font)
+        state->font = font;
+    uint32_t brush = parent ? host_dispatch_to_wndproc(c, parent, 0x134, dc, hwnd) : 0;
+    state = gdi::dc_of(dc);
+    if (!state)
+        return;
+    uint32_t background = gdi::argb(state->bk_color), color = 0;
+    if (brush && gdi::brush_color(brush, &color))
+        background = color;
+    uint32_t old_text = state->text_color, old_background = state->bk_color;
+    gdi::fill(dc, {0, 0, width, height}, background);
+    for (size_t i = 0; i < visible.size(); ++i) {
+        int32_t x = columns ? int32_t(i / rows) * column_width : 0;
+        int32_t y = int32_t((columns ? i % rows : i) * row_height);
+        if (visible[i].selected) {
+            gdi::fill(dc, {x, y, x + column_width, int32_t(y + row_height)}, 0xff0078d7u);
+            state->text_color = 0xffffff;
+        } else
+            state->text_color = old_text;
+        uint32_t units = wide_units(visible[i].text);
+        uint32_t block = heap_alloc(16 + (units + 1) * 2, true);
+        if (block) {
+            wr32(block, uint32_t(x + 2));
+            wr32(block + 4, uint32_t(y));
+            wr32(block + 8, uint32_t(x + column_width));
+            wr32(block + 12, uint32_t(y + row_height));
+            gm_put_wstr(block + 16, visible[i].text, units + 1);
+            gdi::draw_text(dc, block + 16, units, block, 0x820); // SINGLELINE | NOPREFIX
+            heap_free(block);
+        }
+    }
+    state->text_color = old_text;
+    state->bk_color = old_background;
+    state->font = old_font;
+    if (!into)
+        gdi_release_window_dc(hwnd, dc);
+}
+uint32_t find(const Window &w, uint32_t start, const std::string &text, bool exact) {
+    auto query = folded(text);
+    size_t count = w.list_items.size();
+    if (!count)
+        return ERROR;
+    for (size_t i = 0; i < count; ++i) {
+        size_t n = (uint64_t(start) + 1 + i) % count;
+        if (start == ERROR)
+            n = i;
+        auto candidate = folded(w.list_items[n].text);
+        if (exact ? candidate == query : candidate.compare(0, query.size(), query) == 0)
+            return uint32_t(n);
+    }
+    return ERROR;
+}
+} // namespace
+
+void listbox_proc(X86 *c) {
+    uint32_t hwnd = arg(c, 0), msg = arg(c, 1), wp = arg(c, 2), lp = arg(c, 3);
+    Window *w = find_window(hwnd);
+    if (!w) {
+        set_eax(c, ERROR);
+        return;
+    }
+    LOGV("ListBox(%08x): msg=%04x wp=%08x lp=%08x", hwnd, msg, wp, lp);
+    uint32_t result = 0;
+    switch (msg) {
+    case 0xf:
+    case 0x318:
+        paint(c, hwnd, wp);
+        break;
+    case 0x30: // WM_SETFONT
+        w->font = wp;
+        if (lp)
+            w->update_pending = true;
+        break;
+    case 0x31:
+        result = w->font;
+        break;
+    case 0x87:
+        result = 0x81;
+        break; // DLGC_WANTARROWS | DLGC_WANTCHARS
+    case 0x180:
+    case 0x181: { // LB_ADDSTRING / LB_INSERTSTRING
+        if (w->style & 0x2000) {
+            result = ERROR;
+            break;
+        } // unsupported LBS_NODATA
+        ListItem item;
+        if (has_strings(*w)) {
+            if (!lp || !gm_valid(lp, w->unicode ? 2 : 1)) {
+                result = ERROR;
+                break;
+            }
+            item.text = w->unicode ? gm_wstr(lp) : gm_str(lp);
+        } else
+            item.data = lp;
+        size_t n = msg == 0x181 && wp != ERROR ? std::min<size_t>(wp, w->list_items.size())
+                                               : w->list_items.size();
+        if (msg == 0x180 && (w->style & 2) && has_strings(*w)) {
+            auto query = folded(item.text);
+            n = 0;
+            while (n < w->list_items.size() && folded(w->list_items[n].text) <= query)
+                ++n;
+        }
+        w->list_items.insert(w->list_items.begin() + n, std::move(item));
