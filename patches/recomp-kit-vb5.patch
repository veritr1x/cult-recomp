+// window model retains ANSI bytes or UTF-8 for Unicode windows; selection
+// positions are TCHAR offsets. Parent callbacks can destroy the window.
+#include "user32_internal.h"
+#include "memory.h"
+#include <algorithm>
+#include <climits>
+
+namespace user32 {
+namespace {
+uint32_t length(const Window &w) {
+    return w.unicode ? wide_units(w.title_utf8) : uint32_t(w.title_utf8.size());
+}
+// Translate a UTF-16 selection offset into an offset of the model's UTF-8
+// string. ANSI offsets already index bytes. Do not split a surrogate pair.
+size_t byte_offset(const Window &w, uint32_t offset) {
+    if (!w.unicode)
+        return std::min<size_t>(offset, w.title_utf8.size());
+    size_t n = 0;
+    uint32_t units = 0;
+    while (n < w.title_utf8.size() && units < offset) {
+        uint8_t ch = uint8_t(w.title_utf8[n]);
+        size_t bytes = ch < 0x80 ? 1 : ch < 0xe0 ? 2 : ch < 0xf0 ? 3 : 4;
+        units += bytes == 4 ? 2 : 1;
+        n = std::min(n + bytes, w.title_utf8.size());
+    }
+    return n;
+}
+void notify(X86 *c, uint32_t hwnd, uint32_t code) {
+    Window *w = find_window(hwnd);
+    if (w && w->parent) {
+        uint32_t parent = w->parent, id = w->id;
+        host_dispatch_to_wndproc(c, parent, 0x111, (code << 16) | (id & 0xffff), hwnd);
+    }
+}
+void changed(X86 *c, uint32_t hwnd) {
+    notify(c, hwnd, 0x400); // EN_UPDATE
+    if (find_window(hwnd))
+        notify(c, hwnd, 0x300); // EN_CHANGE
+}
+void replace(X86 *c, uint32_t hwnd, const std::string &text, bool undo, bool typed) {
+    Window *w = find_window(hwnd);
+    if (!w || (typed && w->edit_readonly))
+        return;
+    uint32_t total = length(*w);
+    uint32_t start = std::min({w->edit_start, w->edit_end, total});
+    uint32_t end = std::min(std::max(w->edit_start, w->edit_end), total);
+    uint32_t inserted = w->unicode ? wide_units(text) : uint32_t(text.size());
+    if (typed && uint64_t(total - (end - start)) + inserted > w->edit_limit) {
+        notify(c, hwnd, 0x501); // EN_MAXTEXT
+        return;
+    }
+    size_t first = byte_offset(*w, start), last = byte_offset(*w, end);
+    if (undo) {
+        w->edit_undo = w->title_utf8;
+        w->edit_can_undo = true;
+    } else
+        w->edit_can_undo = false;
+    w->title_utf8.replace(first, last - first, text);
+    w->edit_start = w->edit_end = start + inserted;
+    w->edit_modified = true;
+    w->update_pending = true;
+    changed(c, hwnd);
+}
+std::string character(uint16_t unit, bool wide) {
+    if (!wide)
+        return std::string(1, char(unit));
+    if (unit < 0x80)
+        return std::string(1, char(unit));
+    if (unit < 0x800)
+        return {char(0xc0 | (unit >> 6)), char(0x80 | (unit & 63))};
+    return {char(0xe0 | (unit >> 12)), char(0x80 | ((unit >> 6) & 63)), char(0x80 | (unit & 63))};
+}
+void paint(X86 *c, uint32_t hwnd, uint32_t into) {
+    Window *w = find_window(hwnd);
+    if (!w)
+        return;
+    if (!into)
+        w->update_pending = false;
+    uint32_t parent = w->parent, font = w->font;
+    int32_t width = w->w, height = w->h;
+    uint16_t margin_left = w->edit_margin_left, margin_right = w->edit_margin_right;
+    bool multiline = (w->style & 4) != 0;
+    std::string text =
+        w->edit_password
+            ? std::string(length(*w), char(w->edit_password < 128 ? w->edit_password : '*'))
+            : w->title_utf8;
+    if (!w->unicode && !w->edit_password) {
+        // Convert the ANSI window's bytes for the shared UTF-16 text renderer.
+        std::string utf8;
+        for (uint8_t byte : text)
+            utf8 += character(gdi::font_ansi_unit(byte), true);
+        text = std::move(utf8);
+    }
+    uint32_t dc = into ? into : gdi_window_dc(hwnd);
+    auto *state = gdi::dc_of(dc);
+    if (!state)
+        return;
+    uint32_t old_font = state->font;
+    if (font)
+        state->font = font;
+    uint32_t brush = parent ? host_dispatch_to_wndproc(c, parent, 0x133, dc, hwnd) : 0;
+    state = gdi::dc_of(dc);
+    if (!state)
+        return;
+    uint32_t pixel = gdi::argb(state->bk_color), color = 0;
+    if (brush && gdi::brush_color(brush, &color))
+        pixel = color;
+    gdi::fill(dc, {0, 0, width, height}, pixel);
+    uint32_t units = wide_units(text), block = heap_alloc(16 + (units + 1) * 2, true);
+    if (block) {
+        wr32(block, margin_left);
+        wr32(block + 4, 1);
+        wr32(block + 8, uint32_t(width - margin_right));
+        wr32(block + 12, uint32_t(height));
+        gm_put_wstr(block + 16, text, units + 1);
+        gdi::draw_text(dc, block + 16, units, block, multiline ? 0x810 : 0x820);
+        heap_free(block);
+    }
+    if (auto *after = gdi::dc_of(dc))
+        after->font = old_font;
+    if (!into)
+        gdi_release_window_dc(hwnd, dc);
+}
+} // namespace
+void edit_proc(X86 *c) {
+    uint32_t hwnd = arg(c, 0), msg = arg(c, 1), wp = arg(c, 2), lp = arg(c, 3);
+    Window *w = find_window(hwnd);
+    if (!w) {
+        set_eax(c, 0);
+        return;
+    }
+    LOGV("Edit(%08x): msg=%04x wp=%08x lp=%08x", hwnd, msg, wp, lp);
+    uint32_t result = 0;
+    switch (msg) {
+    case 1:
+        w->edit_readonly = (w->style & 0x800) != 0;
+        w->edit_password = w->style & 0x20 ? '*' : 0;
+        break;
+    case 0xc: // WM_SETTEXT is not constrained by EM_LIMITTEXT
+        def_window_proc(c, w->unicode);
+        w = find_window(hwnd);
+        if (w) {
+            w->edit_start = w->edit_end = 0;
+            w->edit_modified = false;
+            w->edit_can_undo = false;
+            w->update_pending = true;
+            changed(c, hwnd);
+        }
+        result = w ? 1 : 0;
+        break;
+    case 0xf:
+    case 0x318:
+        paint(c, hwnd, wp);
+        break;
+    case 0x30:
+        w->font = wp;
+        if (lp)
+            w->update_pending = true;
+        break;
+    case 0x31:
+        result = w->font;
+        break;
+    case 0x87:
+        result = 0x89;
+        break; // WANTARROWS | WANTCHARS | HASSETSEL
+    case 0xb0: // EM_GETSEL
+        if ((wp && !gm_valid(wp, 4)) || (lp && !gm_valid(lp, 4)))
+            break;
+        if (wp)
+            wr32(wp, std::min(w->edit_start, w->edit_end));
+        if (lp)
+            wr32(lp, std::max(w->edit_start, w->edit_end));
+        result = w->edit_start > 65535 || w->edit_end > 65535
+                     ? 0xffffffffu
+                     : (std::max(w->edit_start, w->edit_end) << 16) |
+                           std::min(w->edit_start, w->edit_end);
+        break;
+    case 0xb1: // EM_SETSEL
+        if (wp == 0xffffffffu)
+            w->edit_start = w->edit_end;
+        else {
+            w->edit_start = std::min(wp, length(*w));
+            w->edit_end = lp == 0xffffffffu ? length(*w) : std::min(lp, length(*w));
+        }
+        break;
+    case 0xb2: // EM_GETRECT
+        if (lp && gm_valid(lp, 16)) {
+            wr32(lp, w->edit_margin_left);
+            wr32(lp + 4, 1);
+            wr32(lp + 8, uint32_t(w->w - w->edit_margin_right));
+            wr32(lp + 12, uint32_t(w->h));
+        }
+        break;
+    case 0xb8:
+        result = w->edit_modified;
+        break;
+    case 0xb9:
+        w->edit_modified = wp != 0;
+        break;
+    case 0xba: { // EM_GETLINECOUNT
+        result = 1;
+        if (w->style & 4)
+            result += uint32_t(std::count(w->title_utf8.begin(), w->title_utf8.end(), '\n'));
+        break;
+    }
+    case 0xbb: // EM_LINEINDEX, single-line control
+        result = wp == 0 || wp == 0xffffffffu ? 0 : 0xffffffffu;
+        break;
+    case 0xc1:
+        result = length(*w);
+        break; // EM_LINELENGTH, single-line control
+    case 0xc2: // EM_REPLACESEL
+        replace(c, hwnd, w->unicode ? gm_wstr(lp) : gm_str(lp), wp != 0, false);
+        break;
+    case 0xc5:
+        w->edit_limit = wp ? std::min(wp, 0x7ffffffeu) : (w->style & 4 ? 1 : 0x7ffffffeu);
+        break;
+    case 0xc6:
+        result = w->edit_can_undo;
+        break;
+    case 0xc7: // EM_UNDO
+        if (w->edit_can_undo) {
+            w->title_utf8.swap(w->edit_undo);
+            w->edit_start = w->edit_end = length(*w);
+            w->edit_modified = true;
+            w->update_pending = true;
+            result = 1;
+            changed(c, hwnd);
+        }
+        break;
+    case 0xcc:
+        w->edit_password = wp & 0xffff;
+        w->update_pending = true;
+        break;
+    case 0xcd:
+        w->edit_can_undo = false;
+        w->edit_undo.clear();
+        break;
+    case 0xce:
+    case 0xcb: // EM_GETFIRSTVISIBLELINE / EM_SCROLLCARET for unscrolled text
+        break;
+    case 0xcf:
+        w->edit_readonly = wp != 0;
+        result = 1;
+        break;
+    case 0xd2:
+        result = w->edit_password;
+        break;
+    case 0xd3: // EM_SETMARGINS; EC_USEFONTINFO restores the default inset.
+        if (wp & 1)
+            w->edit_margin_left = uint16_t(lp) == 0xffff ? 2 : uint16_t(lp);
+        if (wp & 2)
+            w->edit_margin_right = uint16_t(lp >> 16) == 0xffff ? 2 : uint16_t(lp >> 16);
+        w->update_pending = true;
+        break;
+    case 0xd4:
+        result = uint32_t(w->edit_margin_left) | (uint32_t(w->edit_margin_right) << 16);
+        break;
+    case 0xd5:
+        result = w->edit_limit;
+        break;
+    case 0x102: // WM_CHAR
+        if (!w->enabled || w->edit_readonly)
+            break;
+        if (wp == 8) {
+            if (w->edit_start == w->edit_end && w->edit_start)
+                --w->edit_start;
+            replace(c, hwnd, "", true, true);
+        } else if (wp >= 32 && wp < 0xd800)
+            replace(c, hwnd, character(uint16_t(wp), w->unicode), true, true);
+        else if (wp == 13 && (w->style & 4))
+            replace(c, hwnd, "\r\n", true, true);
+        break;
+    case 0x100: // WM_KEYDOWN: caret and Delete
+        if (wp == 0x24)
+            w->edit_start = w->edit_end = 0;
+        else if (wp == 0x23)
+            w->edit_start = w->edit_end = length(*w);
+        else if (wp == 0x25)
+            w->edit_start = w->edit_end = w->edit_start ? w->edit_start - 1 : 0;
+        else if (wp == 0x27)
+            w->edit_start = w->edit_end = std::min(w->edit_end + 1, length(*w));
+        else if (wp == 0x2e && !w->edit_readonly) {
+            if (w->edit_start == w->edit_end)
+                w->edit_end = std::min(w->edit_end + 1, length(*w));
+            replace(c, hwnd, "", true, true);
+        }
+        break;
+    default:
+        if (msg >= 0xb0 && msg <= 0xda) {
+            log_once(("edit-message:" + std::to_string(msg)).c_str(),
+                     "Edit message %04x is unsupported", msg);
+        } else {
+            def_window_proc(c, w->unicode);
+            return;
+        }
+    }
+    set_eax(c, result);
+}
+} // namespace user32
