+    check(method(stm, 5, {stm, 0xfffffffeu, 0xffffffffu, 2, offset}) == 0 && rd32(offset) == 3 &&
+              rd32(offset + 4) == 0,
+          "Seek accepts a signed 64-bit displacement from the end");
+    memset(g_mem + readback, 0xcc, 8);
