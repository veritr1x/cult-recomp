+              method(cloned, 4, {cloned, data + 1, 1, count}) == 0,
+          "clone writes share data while keeping an independent seek pointer");
+    check(method(stm, 5, {stm, 0, 0, 1, offset}) == 0 && rd32(offset) == 9,
+          "clone seeking does not move the original stream");
+    check(method(stm, 12, {stm, info, 0}) == 0 && rd32(info + 4) == 2 && rd32(info + 8) == 9 &&
+              rd32(info + 40) == 0x12 && gm_wstr(rd32(info)) == "Image",
+          "STATSTG reports x86 offsets and a task-owned stream name");
+    call_import(&c, "ole32.dll", "CoTaskMemFree", {rd32(info)});
+    memset(g_mem + iid, 0, 16);
+    wr32(iid, 0x0c);
+    wr8(iid + 8, 0xc0);
+    wr8(iid + 15, 0x46);
+    check(method(stm, 0, {stm, iid, out}) == 0 && rd32(out) == stm && method(stm, 2, {stm}) == 1,
+          "IStream QueryInterface preserves identity and reference ownership");
+    check(method(stm, 6, {stm, 3, 0}) == 0 && method(stm, 12, {stm, info, 1}) == 0 &&
+              rd32(info + 8) == 3,
+          "SetSize truncates data and STATFLAG_NONAME returns no allocation");
+    check(method(stm, 6, {stm, 0, 1}) == 0x80030008u && method(stm, 12, {stm, info, 1}) == 0 &&
+              rd32(info + 8) == 3,
+          "oversized storage requests fail without changing the data");
+    check(method(root, 4, {root, name, 0, 0x10, 0, out}) == 0x80030020u && rd32(out) == 0,
+          "exclusive stream opens reject a second open identity");
+    check(method(root, 3, {root, other, 0x12, 0, 0, out}) == 0,
+          "create a separate CopyTo destination");
+    uint32_t dest = rd32(out);
+    check(method(stm, 5, {stm, 0, 0, 0, offset}) == 0 &&
+              method(stm, 7, {stm, dest, 10, 0, offset, offset + 8}) == 0 && rd32(offset) == 3 &&
+              rd32(offset + 8) == 3,
+          "CopyTo invokes guest Write and reports actual 64-bit byte counts");
+    check(method(dest, 5, {dest, 0, 0, 0, offset}) == 0 &&
+              method(dest, 3, {dest, readback, 3, count}) == 0 &&
+              !memcmp(g_mem + readback, "BBC", 3),
+          "copied destination contains the original stream bytes");
+    method(dest, 2, {dest});
+    method(root, 12, {root, other});
+    method(cloned, 2, {cloned});
+    method(stm, 2, {stm});
+    check(method(root, 13, {root, name, other}) == 0 &&
+              method(root, 4, {root, other, 0, 0x10, 0, out}) == 0,
+          "RenameElement retains data under the new name");
+    uint32_t reopened = rd32(out);
+    check(method(reopened, 3, {reopened, readback, 3, count}) == 0 &&
+              !memcmp(g_mem + readback, "BBC", 3),
+          "reopened stream starts at zero and sees clone writes");
+    check(method(reopened, 4, {reopened, data, 1, count}) == 0x80030005u,
+          "read-only streams reject writes");
+    check(method(root, 12, {root, other}) == 0 &&
+              method(root, 4, {root, other, 0, 0x10, 0, out}) == 0x80030002u && rd32(out) == 0,
+          "DestroyElement removes the named stream and failed open clears output");
+    check(method(reopened, 3, {reopened, readback, 1, count}) == 0x80030102u,
+          "DestroyElement invalidates existing stream interfaces");
+    check(method(reopened, 2, {reopened}) == 0 && !heap_owns(reopened),
+          "final stream Release frees its guest object");
+    check(method(root, 2, {root}) == 0 && !heap_owns(root),
+          "temporary storage is released with its final reference");
+    call_import(&c, "ole32.dll", "StgCreateDocfile", {0, 0x04000012, 0, out});
+    root = rd32(out);
+    check(method(root, 3, {root, name, 0x12, 0, 0, out}) == 0,
+          "open a stream whose parent lifetime ends first");
+    stm = rd32(out);
+    method(root, 2, {root});
+    check(method(stm, 3, {stm, readback, 1, count}) == 0x80030102u,
+          "final parent Release invalidates its remaining streams, matching Windows");
+    check(method(stm, 2, {stm}) == 0 && !heap_owns(stm),
+          "invalidated streams retain their Release contract");
+}
