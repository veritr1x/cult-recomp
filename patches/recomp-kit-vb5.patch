+static void test_module_icon_resources() {
+    section("mapped module icon resources");
+    X86 c;
+    loader_init_context(&c);
+    for (uint32_t m = 0; m < loader_module_count(); ++m) {
+        const LoaderModule *module = loader_module(m);
+        std::vector<ResourceName> names;
+        if (!resource_names(14, &names, nullptr, module->base))
