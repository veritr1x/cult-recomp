+              call_import(&c, "USER32.dll", "CharNextA", {s + 4}) == s + 4,
+          "CharNextA advances a code-page-1252 byte and stops at the terminator");
+    gm_put_str(s, "FixtureFormat", 64);
+    gm_put_wstr(s + 128, "fixtureformat", 64);
+    uint32_t fmt = call_import(&c, "USER32.dll", "RegisterClipboardFormatA", {s});
+    check(fmt >= 0xc000 && fmt <= 0xffff &&
+              call_import(&c, "USER32.dll", "RegisterClipboardFormatW", {s + 128}) == fmt,
