+// OLE pictures draw in HIMETRIC coordinates. A scaled 2x2 source must cover
+// every device pixel, and a negative viewport extent must invert the image.
+static void test_window_copy_equivalence() {
+    X86 c;
+    loader_init_context(&c);
+    const uint32_t s = 0x00347000;
+    uint32_t first = make_test_window(&c, s, 16, 16);
+    uint32_t second = make_test_window(&c, s, 16, 16);
+    uint32_t out = call_import(&c, "USER32.dll", "GetDC", {first});
+    uint32_t reference = call_import(&c, "USER32.dll", "GetDC", {second});
+    uint32_t read_first = call_import(&c, "USER32.dll", "GetDC", {first});
+    uint32_t read_second = call_import(&c, "USER32.dll", "GetDC", {second});
+    uint32_t source = call_import(&c, "GDI32.dll", "CreateCompatibleDC", {0});
+    uint32_t slow = call_import(&c, "GDI32.dll", "CreateCompatibleDC", {0});
+    uint32_t bitmap = call_import(&c, "GDI32.dll", "CreateBitmap", {4, 3, 1, 32, 0});
+    call_import(&c, "GDI32.dll", "SelectObject", {source, bitmap});
+    call_import(&c, "GDI32.dll", "SelectObject", {slow, bitmap});
+    for (uint32_t y = 0; y < 3; ++y)
+        for (uint32_t x = 0; x < 4; ++x)
+            call_import(&c, "GDI32.dll", "SetPixel", {source, x, y, 0x10203u * (1 + y * 4 + x)});
+    // A full source clip forces the general blitter with identical valid pixels.
+    call_import(&c, "GDI32.dll", "IntersectClipRect", {slow, 0, 0, 4, 3});
+    for (uint32_t dc : {out, reference}) {
+        call_import(&c, "GDI32.dll", "IntersectClipRect", {dc, 1, 1, 15, 15});
+        call_import(&c, "GDI32.dll", "ExcludeClipRect", {dc, 4, 3, 7, 6});
+    }
+    for (auto origin : {-2, 2}) {
+        call_import(&c, "GDI32.dll", "StretchBlt",
+                    {out, uint32_t(origin), 1, 12, 9, source, uint32_t(-1), 0, 6, 3, 0x00cc0020});
+        call_import(
+            &c, "GDI32.dll", "StretchBlt",
+            {reference, uint32_t(origin), 1, 12, 9, slow, uint32_t(-1), 0, 6, 3, 0x00cc0020});
+        bool equal = true;
+        for (uint32_t y = 0; y < 16; ++y)
+            for (uint32_t x = 0; x < 16; ++x)
+                equal &= call_import(&c, "GDI32.dll", "GetPixel", {read_first, x, y}) ==
+                         call_import(&c, "GDI32.dll", "GetPixel", {read_second, x, y});
+        check(equal,
+              "window copy matches general blit with scaling, outside source pixels and clip holes "
+              "(%d)",
+              origin);
+    }
+    check(call_import(&c, "GDI32.dll", "GetPixel", {out, 8, 7}) != 0,
+          "equivalent window copies actually draw source pixels");
+    call_import(&c, "GDI32.dll", "DeleteDC", {source});
+    call_import(&c, "GDI32.dll", "DeleteDC", {slow});
+    call_import(&c, "GDI32.dll", "DeleteObject", {bitmap});
+    call_import(&c, "USER32.dll", "ReleaseDC", {first, out});
+    call_import(&c, "USER32.dll", "ReleaseDC", {second, reference});
+    call_import(&c, "USER32.dll", "ReleaseDC", {first, read_first});
+    call_import(&c, "USER32.dll", "ReleaseDC", {second, read_second});
+    call_import(&c, "USER32.dll", "DestroyWindow", {first});
+    call_import(&c, "USER32.dll", "DestroyWindow", {second});
+}
+static void test_anisotropic_picture_mapping() {
+    X86 c;
+    loader_init_context(&c);
+    uint32_t s = 0x00348000;
+    uint32_t hwnd = make_test_window(&c, s, 16, 16);
+    uint32_t dc = call_import(&c, "USER32.dll", "GetDC", {hwnd});
+    uint32_t reader = call_import(&c, "USER32.dll", "GetDC", {hwnd});
+    uint32_t source = call_import(&c, "GDI32.dll", "CreateCompatibleDC", {0});
+    uint32_t bitmap = call_import(&c, "GDI32.dll", "CreateBitmap", {2, 2, 1, 32, 0});
+    call_import(&c, "GDI32.dll", "SelectObject", {source, bitmap});
+    const uint32_t colors[] = {0x0000ff, 0x00ff00, 0xff0000, 0xffffff};
+    for (uint32_t y = 0; y < 2; ++y)
+        for (uint32_t x = 0; x < 2; ++x)
+            call_import(&c, "GDI32.dll", "SetPixel", {source, x, y, colors[y * 2 + x]});
+    check(call_import(&c, "GDI32.dll", "SetMapMode", {dc, 8}) == 1,
+          "anisotropic mapping preserves the previous mode");
+    call_import(&c, "GDI32.dll", "SetWindowExtEx", {dc, 1000, 1000, 0});
+    call_import(&c, "GDI32.dll", "SetViewportExtEx", {dc, 4, 4, 0});
+    call_import(&c, "GDI32.dll", "SetViewportOrgEx", {dc, 2, 3, 0});
+    check(call_import(&c, "GDI32.dll", "StretchBlt",
+                      {dc, 0, 0, 1000, 1000, source, 0, 0, 2, 2, 0x00cc0020}) != 0,
+          "HIMETRIC picture renders through StretchBlt");
+    bool complete = true;
+    for (uint32_t y = 0; y < 4; ++y)
+        for (uint32_t x = 0; x < 4; ++x)
+            complete &= call_import(&c, "GDI32.dll", "GetPixel", {reader, x + 2, y + 3}) ==
+                        colors[(y / 2) * 2 + x / 2];
+    check(complete, "scaled picture fills all four colored quadrants without gaps");
+    uint32_t saved = call_import(&c, "GDI32.dll", "SaveDC", {dc});
+    call_import(&c, "GDI32.dll", "SetViewportExtEx", {dc, 4, uint32_t(-4), 0});
+    call_import(&c, "GDI32.dll", "SetViewportOrgEx", {dc, 8, 7, 0});
+    call_import(&c, "GDI32.dll", "StretchBlt",
+                {dc, 0, 0, 1000, 1000, source, 0, 0, 2, 2, 0x00cc0020});
+    complete = true;
+    for (uint32_t y = 0; y < 4; ++y)
+        for (uint32_t x = 0; x < 4; ++x)
+            complete &= call_import(&c, "GDI32.dll", "GetPixel", {reader, x + 8, y + 3}) ==
+                        colors[((3 - y) / 2) * 2 + x / 2];
+    check(complete, "negative viewport y extent mirrors the complete image");
+    check(call_import(&c, "GDI32.dll", "RestoreDC", {dc, saved}) != 0,
+          "RestoreDC restores picture mapping state");
+    call_import(&c, "GDI32.dll", "GetViewportExtEx", {dc, s + 0x100});
+    check(rd32(s + 0x100) == 4 && rd32(s + 0x104) == 4,
+          "saved mapping extents survive a temporary inversion");
+    check(call_import(&c, "GDI32.dll", "SetWindowExtEx", {dc, 0, 1000, 0}) == 0,
+          "zero anisotropic extent is refused");
+    call_import(&c, "GDI32.dll", "GetWindowExtEx", {dc, s + 0x100});
+    check(rd32(s + 0x100) == 1000 && rd32(s + 0x104) == 1000,
+          "invalid extent leaves the previous mapping intact");
+    // Equal extents translate exactly, including negative extents and origins
+    // whose difference exceeds 32 bits. The saturated result must not wrap.
+    call_import(&c, "GDI32.dll", "SetWindowExtEx", {dc, uint32_t(-7), 9, 0});
+    call_import(&c, "GDI32.dll", "SetViewportExtEx", {dc, uint32_t(-7), 9, 0});
+    call_import(&c, "GDI32.dll", "SetWindowOrgEx", {dc, uint32_t(INT_MIN), INT_MAX, 0});
+    call_import(&c, "GDI32.dll", "SetViewportOrgEx", {dc, INT_MAX, uint32_t(INT_MIN), 0});
+    int64_t px = 0, py = 0;
+    check(gdi::mapping_point(dc, &px, &py) && px == INT_MAX && py == INT_MIN,
+          "equal extents saturate translated coordinates without integer wrap");
+    call_import(&c, "GDI32.dll", "SetWindowOrgEx", {dc, 3, 4, 0});
+    call_import(&c, "GDI32.dll", "SetViewportOrgEx", {dc, 5, 6, 0});
+    call_import(&c, "GDI32.dll", "SetPixel", {dc, 0, 0, 0x123456});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {reader, 2, 2}) == 0x123456,
+          "pixel drawing with equal negative extents preserves origin translation");
+    call_import(&c, "GDI32.dll", "DeleteDC", {source});
+    call_import(&c, "GDI32.dll", "DeleteObject", {bitmap});
+    call_import(&c, "USER32.dll", "ReleaseDC", {hwnd, reader});
+    call_import(&c, "USER32.dll", "ReleaseDC", {hwnd, dc});
+    call_import(&c, "USER32.dll", "DestroyWindow", {hwnd});
+}
+// A 32-bpp source must fit the caller's 24-bpp row buffer exactly. The
+// adjacent canary represents the COM object overwritten by the old raw copy.
+static void test_dib_download_formats() {
+    X86 c;
+    loader_init_context(&c);
+    const uint32_t s = 0x00360000, bmi = s + 0x100, out = s + 0x200;
+    for (unsigned i = 0; i < 4; ++i) {
+        wr32(s + i * 4, 0x00ff0000);      // upper row: red
+        wr32(s + 16 + i * 4, 0x0000ff00); // lower row: green
+    }
+    uint32_t bitmap = call_import(&c, "GDI32.dll", "CreateBitmap", {4, 2, 1, 32, s});
+    check(bitmap != 0, "download fixture has a 32-bpp bitmap");
+    auto format = [&](int height, int bpp) {
+        memset(g_mem + bmi, 0, 64);
+        wr32(bmi, 40);
+        wr32(bmi + 4, 4);
+        wr32(bmi + 8, uint32_t(height));
+        wr16(bmi + 12, 1);
+        wr16(bmi + 14, uint16_t(bpp));
+    };
+    auto download = [&](unsigned start, unsigned count) {
+        return call_import(&c, "GDI32.dll", "GetDIBits", {0, bitmap, start, count, out, bmi, 0});
+    };
+    format(2, 24);
+    memset(g_mem + out, 0xa5, 48);
+    check(download(0, 2) == 2 && rd32(bmi + 20) == 24,
+          "GetDIBits reports the requested 24-bpp size and row count");
+    check(rd8(out) == 0 && rd8(out + 1) == 255 && rd8(out + 2) == 0 && rd8(out + 12) == 0 &&
+              rd8(out + 13) == 0 && rd8(out + 14) == 255,
+          "bottom-up download converts colours and reverses the source's top-down rows");
+    check(rd32(out + 24) == 0xa5a5a5a5 && rd32(out + 28) == 0xa5a5a5a5,
+          "24-bpp download preserves the adjacent object and unused 32-bpp bytes");
+    memset(g_mem + out, 0xa5, 48);
+    check(download(1, 9) == 1 && rd8(out + 2) == 255 && rd32(out + 12) == 0xa5a5a5a5,
+          "partial download starts at the requested scan and clamps to remaining rows");
+    format(-2, 24);
+    check(download(0, 2) == 2 && rd8(out + 2) == 255 && rd8(out + 13) == 255,
+          "negative requested height downloads in top-down order");
+    format(-2, 16);
+    wr32(bmi + 16, 3);
+    wr32(bmi + 40, 0xf800);
+    wr32(bmi + 44, 0x07e0);
+    wr32(bmi + 48, 0x001f);
+    memset(g_mem + out, 0xa5, 48);
+    check(download(0, 2) == 2 && rd16(out) == 0xf800 && rd16(out + 8) == 0x07e0 &&
+              rd32(out + 16) == 0xa5a5a5a5,
+          "bitfield download packs RGB565 within its smaller output buffer");
+    format(2, 24);
+    wr32(bmi + 4, 3);
+    check(download(0, 2) == 0, "mismatched download dimensions are rejected");
+    format(2, 24);
+    check(call_import(&c, "GDI32.dll", "GetDIBits", {0, bitmap, 0, 2, GUEST_SIZE - 8, bmi, 0}) == 0,
+          "download refuses an output range outside the guest arena");
+    check(download(2, 1) == 0, "download rejects a starting scan beyond the bitmap");
+    format(0, 0);
+    check(call_import(&c, "GDI32.dll", "GetDIBits", {0, bitmap, 0, 0, 0, bmi, 0}) != 0 &&
+              rd32(bmi + 4) == 4 && rd32(bmi + 8) == 2 && rd16(bmi + 14) == 32,
+          "null-buffer query reports source attributes without copying pixels");
+    call_import(&c, "GDI32.dll", "DeleteObject", {bitmap});
+}
