+// Basic sequencer command strings use the shared SMF decoder and guest-frame
+// clock. Registry-inferred types, recording, notifications, command-message
+// structures, arbitrary seek ranges and synchronous wait flags remain unsupported.
+uint32_t mci_command(const std::string &command, std::string &reply) {
+    std::vector<std::string> words;
+    if (!command_words(command, words))
+        return 290; // MCIERR_BAD_CONSTANT
+    std::string verb = command_lower(words[0]);
+    if (verb == "open") {
+        if (words.size() != 6 || command_lower(words[2]) != "type" ||
+            command_lower(words[3]) != "sequencer" || command_lower(words[4]) != "alias" ||
+            words[5].empty())
+            return 259; // MCIERR_UNRECOGNIZED_KEYWORD
+        std::string alias = command_lower(words[5]);
+        if (!mci.alias.empty() && alias == mci.alias)
+            return 289; // MCIERR_DUPLICATE_ALIAS
+        if (opened || !mci.alias.empty())
+            return 265; // MCIERR_DEVICE_OPEN
+        std::vector<Event> parsed;
+        uint64_t duration = 0;
+        uint32_t result = load_sequence(words[1], parsed, duration);
+        if (result)
+            return result;
+        std::string sf2 = win32_midi_soundfont_path();
+        if (!host_midi_open(sf2.empty() ? nullptr : sf2.c_str()))
+            return 266; // MCIERR_DEVICE_NOT_INSTALLED
+        mci.alias = alias;
+        mci.events = std::move(parsed);
+        mci.duration = duration;
+        LOGV("MCI sequencer: %zu events, %llu milliseconds", mci.events.size(),
+             static_cast<unsigned long long>(duration / 1000));
+        return 0;
+    }
+    if (words.size() < 2)
+        return 273; // MCIERR_MISSING_PARAMETER
+    std::string alias = command_lower(words[1]);
+    if (verb == "close" && alias == "all" && words.size() == 2) {
+        mci_close();
+        return 0;
+    }
+    if (mci.alias.empty() || alias != mci.alias)
+        return 263; // MCIERR_INVALID_DEVICE_NAME
+    mci_pump();
+    if (verb == "status") {
+        if (words.size() != 3)
