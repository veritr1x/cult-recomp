+    uint32_t atom = call_import(&c, "KERNEL32.dll", "GlobalAddAtomA", {s});
+    check(atom >= 0xc000 && call_import(&c, "KERNEL32.dll", "GlobalFindAtomW", {s + 128}) == atom,
+          "ANSI atom addition shares the Unicode atom table");
+    call_import(&c, "KERNEL32.dll", "GlobalDeleteAtom", {atom});
+
+    gm_put_wstr(s + 256, "wide", 64);
+    uint32_t b = call_import(&c, "OLEAUT32.dll", "ord2", {s + 256});
+    check(b && rd32(b - 4) == 8 && gm_wstr(b) == "wide" &&
+              call_import(&c, "OLEAUT32.dll", "ord7", {b}) == 4,
+          "SysAllocString and SysStringLen resolve their actual export ordinals");
+    wr32(s + 384, b);
+    check(call_import(&c, "OLEAUT32.dll", "SysReAllocString", {s + 384, b + 2}) == 1 &&
