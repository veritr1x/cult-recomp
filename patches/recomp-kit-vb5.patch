+            call_import(&c, "GDI32.dll", "DeleteObject", {rd32(scratch + 12)});
+            call_import(&c, "GDI32.dll", "DeleteObject", {rd32(scratch + 16)});
+            call_import(&c, "USER32.dll", "DestroyIcon", {icon});
+            return;
+        }
+    }
+    ++g_skips;
+    printf("  [skip] no auxiliary icon resources\n");
+}
