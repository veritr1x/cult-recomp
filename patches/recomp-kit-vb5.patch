+static void test_system_button() {
+    section("system button input and paint");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t s = scratch;
+    memset(g_mem + s, 0, 128);
+    gm_put_str(s + 64, "ButtonFixtureParent", 32);
+    wr32(s + 4, imports_alloc_trampoline("fixture.dll", "button parent", fixture_button_parent, 4));
+    wr32(s + 36, s + 64);
+    call_import(&c, "USER32.dll", "RegisterClassA", {s});
+    uint32_t parent = call_import(&c, "USER32.dll", "CreateWindowExA",
+                                  {0, s + 64, 0, 0, 0, 0, 100, 100, 0, 0, 0, 0});
+    gm_put_str(s + 96, "Button", 32);
+    uint32_t button = call_import(&c, "USER32.dll", "CreateWindowExA",
+                                  {0, s + 96, 0, 0x50000003, 0, 0, 50, 25, parent, 42, 0, 0});
+    button_notifications = 0;
+    check(button && call_import(&c, "USER32.dll", "GetWindowContextHelpId", {button}) == 0 &&
+              call_import(&c, "USER32.dll", "SetWindowContextHelpId", {button, 123}) == 1 &&
+              call_import(&c, "USER32.dll", "GetWindowContextHelpId", {button}) == 123,
+          "context help IDs belong to the window");
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf5, 0, 0});
+    check(button_notifications == 1 && button_notification_id == 42 &&
+              call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf0, 0, 0}) == 1,
+          "BM_CLICK toggles an automatic checkbox and sends BN_CLICKED");
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0x201, 1, 0x00040004});
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0x202, 0, 0x00040004});
+    check(button_notifications == 2 &&
+              call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf0, 0, 0}) == 0,
+          "pointer press and release route a real click");
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0x201, 1, 0x00040004});
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0x202, 0, 0xfffffff0});
+    check(button_notifications == 2, "release outside the button does not click");
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf1, 0xffffffff, 0});
+    check(call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf0, 0, 0}) == 1,
+          "a Boolean true check request is clamped to the checkbox's checked state");
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf1, 0, 0});
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf5, 0, 0});
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf, 0, 0});
+    uint32_t dc = call_import(&c, "USER32.dll", "GetDC", {button});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 6, 10}) == 0 &&
+              call_import(&c, "GDI32.dll", "GetPixel", {dc, 20, 20}) == 0xf0f0f0,
+          "checkbox painting writes its check and face pixels to the window surface");
+    call_import(&c, "USER32.dll", "ReleaseDC", {button, dc});
+    call_import(&c, "USER32.dll", "EnableWindow", {button, 0});
+    call_import(&c, "USER32.dll", "SendMessageA", {button, 0xf5, 0, 0});
+    check(button_notifications == 3, "disabled buttons do not emit clicks");
+    call_import(&c, "USER32.dll", "DestroyWindow", {parent});
+    call_import(&c, "USER32.dll", "UnregisterClassA", {s + 64, 0});
+}
