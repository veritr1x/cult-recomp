+    check(method(stm, 5, {stm, 0xffffffffu, 0xffffffffu, 0, offset}) == 0x80030001u,
+          "Seek refuses a negative absolute position");
+    check(method(stm, 5, {stm, 8, 0, 0, offset}) == 0 && method(stm, 4, {stm, data, 1, count}) == 0,
+          "writing beyond EOF grows the backing stream");
+    check(method(stm, 5, {stm, 5, 0, 0, offset}) == 0 &&
+              method(stm, 3, {stm, readback, 4, count}) == 0 && rd32(readback) == 0x41000000u,
