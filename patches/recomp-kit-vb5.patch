+static void test_legacy_file_reads() {
+    section("legacy HFILE reads and virtual path lookup");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t s = scratch;
+    struct Fixture {
+        static std::string &directory() {
+            static std::string value;
+            return value;
+        }
+        static int resolve(const char *relative, int, char *out, size_t capacity) {
+            std::string name(relative);
+            for (char &ch : name)
+                ch = char(tolower(static_cast<unsigned char>(ch)));
+            if (directory().empty() || name != "recomp-legacy-contract.txt")
+                return 0;
+            std::string file = directory() + "/recomp-legacy-contract.txt";
+            if (file.size() >= capacity)
+                return 0;
+            memcpy(out, file.c_str(), file.size() + 1);
+            return 1;
+        }
+        Fixture() {
+            char path[1024];
+            snprintf(path, sizeof path, "%s/recomp-cult-legacy-XXXXXX", os_temp_dir());
+            if (os_mkdtemp(path) == 0)
+                directory() = path;
+            win32_set_file_ops(resolve, nullptr);
+        }
+        ~Fixture() {
+            win32_set_file_ops(nullptr, nullptr);
+            if (!directory().empty()) {
+                os_unlink((directory() + "/recomp-legacy-contract.txt").c_str());
+                os_rmdir(directory().c_str());
+                directory().clear();
+            }
+        }
+    } fixture;
+    if (!check(!Fixture::directory().empty(), "created an isolated legacy-file overlay"))
+        return;
+    const std::string path = std::string(RECOMP_GUEST_ROOT) + "\\recomp-legacy-contract.txt";
+    gm_put_str(s, path.c_str(), 260);
+    uint32_t created = call_import(&c, "KERNEL32.dll", "CreateFileA",
+                                   {s, 0xc0000000, 3, 0, 1, 0, 0}); // CREATE_NEW
+    if (!check(created != 0xffffffff, "create an isolated legacy-file fixture"))
+        return;
+    memcpy(g_mem + s + 0x200, "abcd", 4);
+    call_import(&c, "KERNEL32.dll", "WriteFile", {created, s + 0x200, 4, s + 0x210, 0});
+    call_import(&c, "KERNEL32.dll", "CloseHandle", {created});
+    uint32_t handle = call_import(&c, "KERNEL32.dll", "_lopen", {s, 0});
+    check(handle != 0xffffffff && call_import(&c, "KERNEL32.dll", "GetFileSize", {handle, 0}) == 4,
+          "legacy open shares normal file handles and sizes");
+    check(call_import(&c, "KERNEL32.dll", "_llseek", {handle, uint32_t(-2), 2}) == 2 &&
+              call_import(&c, "KERNEL32.dll", "_lread", {handle, s + 0x200, 4}) == 2 &&
+              !memcmp(g_mem + s + 0x200, "cd", 2),
+          "signed end-relative seek and a short EOF read return real bytes");
+    check(call_import(&c, "KERNEL32.dll", "_lread", {handle, s + 0x200, 4}) == 0,
+          "an EOF read succeeds with zero bytes");
+    check(call_import(&c, "KERNEL32.dll", "_lclose", {handle}) == 0 &&
+              call_import(&c, "KERNEL32.dll", "_lread", {handle, s + 0x200, 1}) == 0xffffffff,
+          "legacy close returns zero and closed reads return HFILE_ERROR");
+    check(call_import(&c, "KERNEL32.dll", "GetShortPathNameA", {s, 0, 0}) == path.size() + 1,
+          "a path-size query includes its terminator");
+    wr32(s + 0x220, 0x12345678);
+    check(call_import(&c, "KERNEL32.dll", "GetShortPathNameA", {s, s + 0x220, 2}) ==
+                  path.size() + 1 &&
+              rd32(s + 0x220) == 0x12345678,
+          "an undersized short-path buffer is not partially overwritten");
+    check(call_import(&c, "KERNEL32.dll", "GetShortPathNameA", {s, s + 0x300, 260}) ==
+                  path.size() &&
+              gm_str(s + 0x300) == path,
+          "a filesystem without short aliases returns the usable original name");
+    gm_put_str(s + 0x500, "recomp-legacy-contract", 64);
+    gm_put_str(s + 0x550, ".txt", 16);
+    check(call_import(&c, "KERNEL32.dll", "SearchPathA",
+                      {0, s + 0x500, s + 0x550, 260, s + 0x300, s + 0x560}) == path.size() &&
+              gm_str(s + 0x300) == path && gm_str(rd32(s + 0x560)) == "recomp-legacy-contract.txt",
+          "SearchPath appends an extension and returns a guest filename pointer");
+    uint32_t of = s + 0x600;
+    handle = call_import(&c, "KERNEL32.dll", "OpenFile", {s + 0x500, of, 0});
+    check(handle == 0xffffffff && rd16(of + 2) == 2,
+          "OpenFile does not invent an extension for a missing bare name");
+    gm_put_str(s + 0x500, "RECOMP-LEGACY-CONTRACT.TXT", 64);
+    handle = call_import(&c, "KERNEL32.dll", "OpenFile", {s + 0x500, of, 0});
+    check(handle != 0xffffffff && rd8(of) == 136 && rd8(of + 1) == 1 && rd16(of + 2) == 0 &&
+              call_import(&c, "KERNEL32.dll", "_lread", {handle, s + 0x200, 4}) == 4 &&
+              !memcmp(g_mem + s + 0x200, "abcd", 4),
+          "OpenFile searches case-insensitively and returns a usable legacy handle");
+    call_import(&c, "KERNEL32.dll", "_lclose", {handle});
+    handle = call_import(&c, "KERNEL32.dll", "OpenFile", {0, of, 0x8000});
+    check(handle != 0xffffffff && call_import(&c, "KERNEL32.dll", "GetFileSize", {handle, 0}) == 4,
+          "OF_REOPEN reads the path captured in OFSTRUCT before overwriting it");
+    call_import(&c, "KERNEL32.dll", "_lclose", {handle});
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s, of, 0x4000}) == 1 && rd16(of + 2) == 0,
+          "OF_EXIST succeeds without retaining an open handle");
+    gm_put_str(s + 0x500, "recomp-nonexistent-contract.txt", 64);
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s + 0x500, of, 0x100}) == 0 &&
+              gm_str(of + 8).find("recomp-nonexistent-contract.txt") != std::string::npos,
+          "OF_PARSE fills a full guest path without creating or opening a file");
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s, of, 0x400}) == 0xffffffff &&
+              rd16(of + 2) == 50,
+          "timestamp verification is rejected instead of silently succeeding");
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s, 0, 0}) == 0xffffffff,
+          "OpenFile requires a writable OFSTRUCT");
+    gm_put_str(s + 0x500, std::string(128, 'x').c_str(), 129);
+    wr32(of + 136, 0x5aa55aa5);
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s + 0x500, of, 0x100}) == 0xffffffff &&
+              rd16(of + 2) == 206 && rd32(of + 136) == 0x5aa55aa5,
+          "oversized legacy paths fail without overflowing OFSTRUCT");
+    handle = call_import(&c, "KERNEL32.dll", "OpenFile", {s, of, 0x1000});
+    check(handle != 0xffffffff && call_import(&c, "KERNEL32.dll", "GetFileSize", {handle, 0}) == 0,
+          "OF_CREATE truncates an existing file through the writable overlay");
+    call_import(&c, "KERNEL32.dll", "_lclose", {handle});
+    check(call_import(&c, "KERNEL32.dll", "OpenFile", {s, of, 0x200}) == 1 &&
+              call_import(&c, "KERNEL32.dll", "OpenFile", {s, of, 0x4000}) == 0xffffffff &&
+              rd16(of + 2) == 2,
+          "OF_DELETE removes the file and subsequent OF_EXIST reports the error");
+    check(call_import(&c, "KERNEL32.dll", "GetShortPathNameA", {s, s + 0x300, 260}) == 0,
+          "short-path lookup refuses a nonexistent file");
+}
