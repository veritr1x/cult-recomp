+static void fixture_interface_addref(X86 *c) {
+    uint32_t p = arg(c, 0);
+    wr32(p + 4, rd32(p + 4) + 1);
+    set_eax(c, rd32(p + 4));
+}
+static void fixture_interface_release(X86 *c) {
+    uint32_t p = arg(c, 0);
+    wr32(p + 4, rd32(p + 4) - 1);
+    set_eax(c, rd32(p + 4));
+}
+static void fixture_interface_query(X86 *c) {
+    uint32_t p = arg(c, 0), iid = arg(c, 1), out = arg(c, 2);
+    wr32(out, 0);
+    if (!rd32(p + 8) || rd32(iid) != 3 || rd32(iid + 4) || rd32(iid + 8) != 0xc0 ||
+        rd32(iid + 12) != 0x46000000) {
+        set_eax(c, 0x80004002u);
+        return;
+    }
+    wr32(p + 4, rd32(p + 4) + 1);
+    wr32(out, p);
+    set_eax(c, 0);
+}
+static void fixture_interface_disconnect(X86 *c) {
+    uint32_t p = arg(c, 0);
+    wr32(p + 12, rd32(p + 12) + 1);
+    set_eax(c, arg(c, 1) ? 0x80070057u : 0x80004005u);
+}
+static void test_automation_interface_ownership() {
+    section("Automation interface ownership");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t obj = scratch, vt = scratch + 16, out = scratch + 96;
+    memset(g_mem + obj, 0, 128);
+    wr32(obj, vt);
+    wr32(obj + 4, 1);
+    uint32_t addref =
+        imports_alloc_trampoline("ownership-fixture.dll", "AddRef", fixture_interface_addref, 1);
+    uint32_t release =
+        imports_alloc_trampoline("ownership-fixture.dll", "Release", fixture_interface_release, 1);
+    wr32(vt + 4, addref);
+    wr32(vt + 8, release);
+    wr32(vt, imports_alloc_trampoline("ownership-fixture.dll", "QueryInterface",
+                                      fixture_interface_query, 3));
+    wr32(vt + 32, imports_alloc_trampoline("ownership-fixture.dll", "DisconnectObject",
+                                           fixture_interface_disconnect, 2));
+    check(call_import(&c, "ole32.dll", "CoDisconnectObject", {obj, 0}) == 0 && rd32(obj + 4) == 1 &&
+              rd32(obj + 12) == 0,
+          "objects without custom marshalers have no remote connections");
+    wr32(obj + 8, 1);
+    check(call_import(&c, "ole32.dll", "CoDisconnectObject", {obj, 0}) == 0x80004005u &&
+              rd32(obj + 4) == 1 && rd32(obj + 12) == 1,
+          "custom disconnect returns its HRESULT and releases the query reference");
+    check(call_import(&c, "ole32.dll", "CoDisconnectObject", {obj, 1}) == 0x80070057u &&
+              rd32(obj + 12) == 1,
+          "reserved disconnect flags fail before invoking the object");
+    check(call_import(&c, "ole32.dll", "CoSetState", {obj}) == 0 && rd32(obj + 4) == 1 &&
+              call_import(&c, "ole32.dll", "CoSetState", {0}) == 0,
+          "legacy CoSetState matches native Windows without acquiring a reference");
+    uint32_t medium = scratch + 128;
+    uint32_t block = call_import(&c, "KERNEL32.dll", "GlobalAlloc", {0, 16});
+    wr32(medium, 1);
+    wr32(medium + 4, block);
+    wr32(medium + 8, 0);
+    call_import(&c, "ole32.dll", "ReleaseStgMedium", {medium});
+    check(!heap_owns(block) && rd32(medium) == 0 && rd32(medium + 4) == block,
+          "a recipient-owned HGLOBAL is freed and the medium invalidated");
+    block = call_import(&c, "KERNEL32.dll", "GlobalAlloc", {0, 16});
+    wr32(obj + 4, 2);
+    wr32(medium, 1);
+    wr32(medium + 4, block);
+    wr32(medium + 8, obj);
+    call_import(&c, "ole32.dll", "ReleaseStgMedium", {medium});
+    check(heap_owns(block) && rd32(obj + 4) == 1 && rd32(medium) == 0,
+          "provider-owned handles survive while the provider reference is released");
+    call_import(&c, "KERNEL32.dll", "GlobalFree", {block});
+    wr32(obj + 4, 3);
+    wr32(medium, 4);
+    wr32(medium + 4, obj);
+    wr32(medium + 8, obj);
+    call_import(&c, "ole32.dll", "ReleaseStgMedium", {medium});
+    check(rd32(obj + 4) == 1,
+          "stream and provider references are both released for an owned stream medium");
+    check(call_import(&c, "OLEAUT32.dll", "ord201", {0, obj}) == 0 && rd32(obj + 4) == 2,
+          "SetErrorInfo owns one additional interface reference");
+    check(call_import(&c, "OLEAUT32.dll", "SetErrorInfo", {0, obj}) == 0 && rd32(obj + 4) == 2,
+          "replacing error info with itself balances the old reference");
+    check(call_import(&c, "OLEAUT32.dll", "GetErrorInfo", {0, out}) == 0 && rd32(out) == obj &&
+              rd32(obj + 4) == 2,
+          "GetErrorInfo transfers the owned reference without adding another");
+    guest_call(&c, release, obj);
+    check(call_import(&c, "OLEAUT32.dll", "GetErrorInfo", {0, out}) == 1 && rd32(out) == 0,
+          "retrieving error information clears the thread's slot");
+    call_import(&c, "OLEAUT32.dll", "SetErrorInfo", {0, obj});
+    check(call_import(&c, "OLEAUT32.dll", "SetErrorInfo", {0, 0}) == 0 && rd32(obj + 4) == 1,
+          "clearing error information releases its reference");
+    check(call_import(&c, "ole32.dll", "CoRegisterMessageFilter", {obj, out}) == 0 &&
+              rd32(out) == 0 && rd32(obj + 4) == 2,
+          "message filter registration owns a reference");
+    check(call_import(&c, "ole32.dll", "CoRegisterMessageFilter", {0, out}) == 0 &&
+              rd32(out) == obj && rd32(obj + 4) == 2,
+          "the previous message filter reference is transferred to its caller");
+    guest_call(&c, release, obj);
+    call_import(&c, "ole32.dll", "CoRegisterMessageFilter", {obj, 0});
+    check(call_import(&c, "ole32.dll", "CoRegisterMessageFilter", {0, 0}) == 0 &&
+              rd32(obj + 4) == 1,
+          "replacing a filter without requesting it releases it");
+}
