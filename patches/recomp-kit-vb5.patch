+static void test_task_allocator() {
+    section("COM task allocator");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t out = scratch, iid = scratch + 64;
+    check(call_import(&c, "ole32.dll", "CoGetMalloc", {2, out}) == 0x80070057u && rd32(out) == 0,
+          "CoGetMalloc rejects a non-task memory context");
+    check(call_import(&c, "ole32.dll", "CoGetMalloc", {1, out}) == 0,
+          "CoGetMalloc supplies a task allocator");
+    uint32_t obj = rd32(out), vt = rd32(obj);
+    check(obj && gm_valid(vt, 36), "allocator has a nine-slot guest vtable");
+    if (!obj || !gm_valid(vt, 36))
+        return;
+    auto method = [&](uint32_t slot, const std::vector<uint32_t> &args) {
+        uint32_t esp = c.r[R_ESP];
+        uint32_t result = guest_call(&c, rd32(vt + slot * 4), args.data(), args.size());
+        check(c.r[R_ESP] == esp, "IMalloc slot %u preserves the caller stack", slot);
+        return result;
+    };
+    uint32_t p = method(3, {obj, 17});
+    check(p && heap_owns(p) && method(6, {obj, p}) == 17,
+          "IMalloc allocation reports its requested size");
+    wr8(p, 0x5a);
+    uint32_t q = method(4, {obj, p, 4096});
+    check(q && rd8(q) == 0x5a && method(6, {obj, q}) == 4096,
+          "IMalloc Realloc preserves contents and updates the size");
+    uint32_t other = heap_alloc(16);
+    check(method(7, {obj, q}) == 1 && method(7, {obj, other}) == 0 &&
+              method(7, {obj, 0}) == 0xffffffffu,
+          "DidAlloc distinguishes task storage, other storage, and NULL");
+    uint32_t task = call_import(&c, "ole32.dll", "CoTaskMemAlloc", {25});
+    check(method(7, {obj, task}) == 1 && method(6, {obj, task}) == 25,
+          "CoTaskMemAlloc shares the IMalloc memory context");
+    method(5, {obj, task});
+    call_import(&c, "ole32.dll", "CoTaskMemFree", {q});
+    check(!heap_owns(task) && !heap_owns(q), "both APIs release shared task storage");
+    heap_free(other);
+    memset(g_mem + iid, 0, 16);
+    wr32(iid, 2);
+    wr8(iid + 8, 0xc0);
+    wr8(iid + 15, 0x46);
+    check(method(0, {obj, iid, out}) == 0 && rd32(out) == obj,
+          "QueryInterface for IMalloc retains the allocator identity");
+    method(2, {obj});
+    method(2, {obj});
+    check(call_import(&c, "ole32.dll", "CoGetMalloc", {1, out}) == 0 && rd32(out) == obj,
+          "the process retains its allocator after client references are released");
+    method(2, {obj});
+    check(call_import(&c, "OLEAUT32.dll", "OaBuildVersion", {}) ==
+              call_import(&c, "OLEAUT32.dll", "ord170", {}),
+          "OLE Automation version resolves by name and ordinal");
+}
