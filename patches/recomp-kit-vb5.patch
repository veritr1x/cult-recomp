+    wr32(s + 36, s + 0x800);
+    call_import(&c, "USER32.dll", "RegisterClassW", {s});
+    uint32_t hwnd = call_import(&c, "USER32.dll", "CreateWindowExW",
+                                {0, s + 0x800, 0, 0x12000000, 0, 0, 16, 12, 0, 0, IMAGE_BASE, 0});
+    uint32_t dc = call_import(&c, "USER32.dll", "BeginPaint", {hwnd, ps});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 1, 1}) == 0x00ff00 && rd32(ps + 4) == 0,
+          "BeginPaint erases with the class brush and reports completion");
+    call_import(&c, "GDI32.dll", "SetPixel", {dc, 1, 1, 0xff});
+    call_import(&c, "USER32.dll", "EndPaint", {hwnd, ps});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 0});
+    dc = call_import(&c, "USER32.dll", "BeginPaint", {hwnd, ps});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 1, 1}) == 0xff,
+          "non-erasing invalidation preserves retained pixels");
+    call_import(&c, "USER32.dll", "EndPaint", {hwnd, ps});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 1});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 0});
+    dc = call_import(&c, "USER32.dll", "BeginPaint", {hwnd, ps});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 1, 1}) == 0x00ff00,
+          "erase request remains sticky across later non-erasing invalidation");
+    call_import(&c, "GDI32.dll", "SetPixel", {dc, 1, 1, 0xff});
+    call_import(&c, "USER32.dll", "EndPaint", {hwnd, ps});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 1});
+    call_import(&c, "USER32.dll", "ValidateRect", {hwnd, 0});
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 0});
+    dc = call_import(&c, "USER32.dll", "BeginPaint", {hwnd, ps});
+    check(call_import(&c, "GDI32.dll", "GetPixel", {dc, 1, 1}) == 0xff,
