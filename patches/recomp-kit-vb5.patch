+void button_click(X86 *c, uint32_t hwnd) {
+    Window *w = find_window(hwnd);
+    if (!w || !w->enabled)
+        return;
+    uint32_t type = w->style & 15, parent = w->parent, id = w->id;
+    if (type == 3)
