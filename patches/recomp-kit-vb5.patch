+void compare_wide_strings(X86 *c, bool ignore_case) {
+    uint32_t a = arg(c, 0), b = arg(c, 1);
+    uint32_t na = wstrlen(a), nb = wstrlen(b);
+    int result = 0;
+    for (uint32_t i = 0; i < std::min(na, nb); ++i) {
+        uint16_t wa = rd16(a + 2 * i), wb = rd16(b + 2 * i);
+        if (ignore_case) {
+            wa = lower_wide(wa);
+            wb = lower_wide(wb);
+        }
+        if (wa != wb) {
+            result = wa < wb ? -1 : 1;
+            break;
+        }
+    }
+    if (!result)
+        result = na < nb ? -1 : na > nb ? 1 : 0;
+    set_eax(c, (uint32_t)result);
+}
