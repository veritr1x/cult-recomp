+    call_import(&c, "ole32.dll", "CoTaskMemFree", {rd32(out)});
+    check(call_import(&c, "ole32.dll", "StringFromIID", {clsid, out}) == 0 &&
+              gm_wstr(rd32(out)) == expected,
+          "StringFromIID shares GUID formatting and allocation ownership");
+    call_import(&c, "ole32.dll", "CoTaskMemFree", {rd32(out)});
+    uint32_t text = scratch + 128;
+    wr16(text, 0x1234);
+    check(call_import(&c, "ole32.dll", "StringFromGUID2", {clsid, text, 38}) == 0 &&
+              rd16(text) == 0x1234,
+          "a GUID output lacking terminator capacity is unchanged");
+    check(call_import(&c, "ole32.dll", "StringFromGUID2", {clsid, text, 39}) == 39 &&
+              gm_wstr(text) == expected && rd16(text + 76) == 0,
+          "StringFromGUID2 counts the terminator and respects its 78-byte span");
+    wr32(out, 0xdeadbeef);
+    check(call_import(&c, "ole32.dll", "StringFromCLSID", {0, out}) == 0x80070057u &&
+              rd32(out) == 0,
+          "invalid GUID allocation clears the output");
+}
+static void test_memory_streams() {
+    section("OLE streams over global memory");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t out = scratch, count = scratch + 4, global_out = scratch + 8;
+    uint32_t data = scratch + 64, info = scratch + 128;
+    auto api = [&](const char *name, std::initializer_list<uint32_t> args) {
+        return call_import(&c, "ole32.dll", name, args);
+    };
+    check(api("CreateStreamOnHGlobal", {0, 1, out}) == 0 && rd32(out),
+          "an empty memory stream supplies an owned interface");
+    uint32_t stm = rd32(out);
+    if (!stm)
+        return;
+    check(api("IStream::Stat", {stm, info, 1}) == 0 && rd32(info + 8) == 0,
+          "the empty stream has logical length zero");
+    memcpy(g_mem + data, "ABCDEFGHIJKL", 12);
+    check(api("IStream::Write", {stm, data, 12, count}) == 0 && rd32(count) == 12,
+          "memory stream writes report their byte count");
+    check(api("GetHGlobalFromStream", {stm, global_out}) == 0 &&
+              !memcmp(g_mem + rd32(global_out), "ABCDEFGHIJKL", 12),
+          "the returned global handle exposes the written bytes");
+    check(api("IStream::Clone", {stm, out}) == 0 && rd32(out) != stm,
+          "memory stream clones share storage with separate identities");
+    uint32_t clone = rd32(out);
+    if (!clone) {
+        api("IStream::Release", {stm});
+        return;
+    }
+    check(api("IStream::SetSize", {clone, 64, 0}) == 0,
+          "a clone may grow the shared backing allocation");
+    check(api("GetHGlobalFromStream", {stm, global_out}) == 0 &&
+              heap_size(rd32(global_out)) >= 64 && rd8(rd32(global_out) + 63) == 0,
+          "all identities expose the current handle after zero-filled growth");
+    uint32_t owned = rd32(global_out);
+    check(api("IStream::Release", {stm}) == 0 && heap_owns(owned),
+          "a live clone retains the owned global allocation");
+    check(api("IStream::Release", {clone}) == 0 && !heap_owns(owned),
+          "the final stream reference frees an owned global handle");
+    uint32_t supplied = heap_alloc(3);
+    memcpy(g_mem + supplied, "XYZ", 3);
+    check(api("CreateStreamOnHGlobal", {supplied, 0, out}) == 0,
+          "caller-owned global memory may back a stream");
+    stm = rd32(out);
+    if (stm) {
+        check(api("IStream::Read", {stm, data, 8, count}) == 1 && rd32(count) == 3 &&
+                  !memcmp(g_mem + data, "XYZ", 3),
+              "the initial stream length is the supplied allocation length");
+        check(api("IStream::Release", {stm}) == 0 && heap_owns(supplied),
+              "delete-on-release false retains the caller's allocation");
+    }
+    heap_free(supplied);
+    wr32(global_out, 0xdeadbeef);
+    check(api("GetHGlobalFromStream", {0, global_out}) == 0x80070057u && rd32(global_out) == 0,
+          "non-memory streams do not invent a backing global handle");
+}
+static void test_transient_storage() {
