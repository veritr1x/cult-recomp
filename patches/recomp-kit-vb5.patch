+// The runtime exposes the en-US locale. Preserve UTF-16 units rather than
+// narrowing them to bytes; fold ASCII and Latin-1 letters for that locale.
+uint16_t lower_wide(uint16_t w) {
+    if ((w >= 'A' && w <= 'Z') || (w >= 0x00c0 && w <= 0x00d6) || (w >= 0x00d8 && w <= 0x00de))
+        return w + 0x20;
+    if (w == 0x0178)
+        return 0x00ff;
+    return w;
