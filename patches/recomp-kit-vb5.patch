+// Transient OLE storage. All interfaces are 32-bit guest objects; host state
+// holds stream bytes and reference ownership under the guest scheduler baton.
+// Named compound files and transactions are deliberately rejected: this is
+// temporary DELETEONRELEASE storage, not a persistent compound-file writer.
+#include "imports.h"
+#include "memory.h"
+#include "win32.h"
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <map>
+#include <memory>
+#include <vector>
+
