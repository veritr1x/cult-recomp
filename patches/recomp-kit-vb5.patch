+static void test_module_string_resources() {
+    section("mapped module string resources");
+    X86 c;
+    loader_init_context(&c);
+    uint32_t out = scratch;
+    for (uint32_t m = 0; m < loader_module_count(); ++m) {
+        const LoaderModule *module = loader_module(m);
+        std::vector<ResourceName> names;
+        if (!resource_names(6, &names, nullptr, module->base))
+            continue;
+        for (const auto &name : names) {
+            if (name.is_string)
+                continue;
+            uint32_t bytes = 0;
+            uint32_t p = resource_data(resource_find(6, name.id, nullptr, module->base), &bytes);
+            uint32_t end = p + bytes;
+            for (uint32_t i = 0; p && i < 16 && p + 2 <= end; ++i) {
+                uint32_t n = rd16(p);
+                p += 2;
+                if (n > (end - p) / 2)
+                    break;
+                if (n) {
+                    uint32_t id = (name.id - 1) * 16 + i;
+                    check(call_import(&c, "USER32.dll", "LoadStringW",
+                                      {module->base, id, out, 0}) == n &&
+                              rd32(out) == p,
+                          "LoadStringW reads the selected auxiliary image");
+                    uint32_t copied = call_import(&c, "USER32.dll", "LoadStringA",
+                                                  {module->base, id, out + 16, 4});
+                    check(copied == std::min(n, 3u) && rd8(out + 16 + copied) == 0,
+                          "LoadStringA truncates and terminates its ANSI buffer");
+                    wr8(out + 16, 0x5a);
+                    check(call_import(&c, "USER32.dll", "LoadStringA",
+                                      {module->base, id, out + 16, 0}) == 0 &&
+                              rd8(out + 16) == 0x5a,
+                          "LoadStringA zero capacity does not write a pointer");
+                    return;
+                }
+                p += n * 2;
+            }
+        }
+    }
+    printf("  [skip] no auxiliary string resource\n");
+    ++g_skips;
+}
