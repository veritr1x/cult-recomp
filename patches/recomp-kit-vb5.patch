+    if (!s) {
+        set_eax(c, INVALID);
+        return;
+    }
+    if (!name_at(arg(c, 1), name)) {
+        set_eax(c, INVALIDNAME);
+        return;
+    }
+    if (!(s->mode & 3)) {
