+// An expired timer must not run before a newly invalidated form has painted.
+// Exercise both retrieval APIs, filters and removal using a real SetTimer.
+static void test_paint_timer_priority() {
+    X86 c;
+    loader_init_context(&c);
+    uint32_t s = 0x00300000, msg = s + 0x100;
+    uint32_t hwnd = make_test_window(&c, s, 64, 48);
+    call_import(&c, "USER32.dll", "ShowWindow", {hwnd, 1});
+    call_import(&c, "USER32.dll", "UpdateWindow", {hwnd});
+    while (call_import(&c, "USER32.dll", "PeekMessageA", {msg, hwnd, 0, 0, 1})) {
+        // Discard creation geometry before testing the three message sources.
+    }
+    static uint32_t clock;
+    clock = 0;
+    host_set_time_source([]() -> uint32_t { return clock; });
+    call_import(&c, "USER32.dll", "SetTimer", {hwnd, 71, 10, 0});
+    clock = 20;
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 0});
+    call_import(&c, "USER32.dll", "PostMessageA", {hwnd, 0x401, 0, 0});
+    call_import(&c, "USER32.dll", "PostMessageA", {hwnd, 0x113, 71, 0});
+    auto peek = [&](uint32_t min, uint32_t max, uint32_t flags) {
+        return call_import(&c, "USER32.dll", "PeekMessageA", {msg, hwnd, min, max, flags});
+    };
+    check(peek(0, 0, 1) && rd32(msg + 4) == 0x401,
+          "ordinary posted messages precede pending paint and expired timers");
+    check(peek(0, 0, 1) && rd32(msg + 4) == 0x113 && rd32(msg + 8) == 71,
+          "explicitly posted WM_TIMER keeps ordinary queue priority");
+    check(peek(0, 0, 1) && rd32(msg + 4) == 0xf,
+          "PeekMessage retrieves pending paint before a generated timer");
+    check(call_import(&c, "USER32.dll", "GetMessageA", {msg, hwnd, 0, 0}) == 1 &&
+              rd32(msg + 4) == 0xf,
+          "GetMessage also retrieves paint first; PM_REMOVE does not validate paint");
+    call_import(&c, "USER32.dll", "ValidateRect", {hwnd, 0});
+    check(peek(0, 0, 0) && rd32(msg + 4) == 0x113 && rd32(msg + 8) == 71 && peek(0, 0, 1) &&
+              rd32(msg + 8) == 71,
+          "PM_NOREMOVE retains the generated timer until a removing retrieval");
+    check(!peek(0, 0, 1), "the removed timer is not duplicated before its next deadline");
+    clock = 40;
+    call_import(&c, "USER32.dll", "InvalidateRect", {hwnd, 0, 0});
+    check(peek(0x113, 0x113, 1) && rd32(msg + 4) == 0x113,
+          "a timer-only filter bypasses unrelated pending paint");
+    call_import(&c, "USER32.dll", "KillTimer", {hwnd, 71});
+    check(peek(0, 0, 1) && rd32(msg + 4) == 0xf,
+          "timer-only retrieval preserves the excluded paint region");
+    call_import(&c, "USER32.dll", "ValidateRect", {hwnd, 0});
+    // The earlier deadline belongs to the higher ID, so map order is wrong.
+    // Advance beyond both deadlines without retrieving any messages, as after
+    // a slow file read, and repeat across the DWORD clock wrap.
+    for (uint32_t start : {1000u, 0xfffffff0u}) {
+        clock = start;
+        call_import(&c, "USER32.dll", "SetTimer", {hwnd, 11, 100, 0});
+        call_import(&c, "USER32.dll", "SetTimer", {hwnd, 22, 10, 0});
+        clock += 200;
+        check(peek(0, 0, 1) && rd32(msg + 4) == 0x113 && rd32(msg + 8) == 22,
+              "expired timers follow deadline order, including clock wrap (%08x)", start);
+        check(call_import(&c, "USER32.dll", "GetMessageA", {msg, hwnd, 0, 0}) == 1 &&
+                  rd32(msg + 4) == 0x113 && rd32(msg + 8) == 11,
+              "the later deadline remains queued after the earlier timer (%08x)", start);
+        call_import(&c, "USER32.dll", "KillTimer", {hwnd, 11});
+        call_import(&c, "USER32.dll", "KillTimer", {hwnd, 22});
+    }
+    call_import(&c, "USER32.dll", "DestroyWindow", {hwnd});
+    host_clear_time_source();
+}
