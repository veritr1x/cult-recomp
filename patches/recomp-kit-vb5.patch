+    uint32_t global = arg(c, 0), out = arg(c, 2);
+    if (!output(out)) {
+        set_eax(c, 0x80004003u);
+        return;
+    }
+    if (global && (!heap_owns(global) || heap_size(global) > MAX_STREAM)) {
+        set_eax(c, 0x80070057u);
+        return;
+    }
+    if (!ensure_vtables()) {
+        set_eax(c, 0x8007000eu);
+        return;
+    }
+    auto bytes = std::make_shared<Bytes>();
+    bytes->memory_stream = true;
+    bytes->global_size = global ? heap_size(global) : 0;
+    // A nonnull backing handle may reserve more bytes than the logical stream.
+    bytes->global = global ? global : heap_alloc(16, true);
+    if (!bytes->global) {
+        set_eax(c, 0x8007000eu);
+        return;
+    }
+    uint32_t object = new_stream(bytes, 2);
+    if (!object) {
+        if (!global)
+            heap_free(bytes->global);
+        set_eax(c, 0x8007000eu);
+        return;
+    }
+    bytes->delete_global = arg(c, 1) != 0;
+    wr32(out, object);
+    set_eax(c, 0);
+}
+void get_global_from_stream(X86 *c) {
+    uint32_t out = arg(c, 1);
+    if (!output(out)) {
+        set_eax(c, 0x80004003u);
+        return;
+    }
+    auto *s = stream(c);
+    if (!s || !s->bytes->memory_stream) {
+        set_eax(c, 0x80070057u);
+        return;
+    }
+    wr32(out, s->bytes->global);
+    set_eax(c, 0);
+}
+} // namespace
+
+void structured_storage_register() {
+    static const ImportShim shims[] = {
+        {"ole32.dll", "StgCreateDocfile", 4, create_docfile},
+        {"ole32.dll", "CreateStreamOnHGlobal", 3, create_global_stream},
+        {"ole32.dll", "GetHGlobalFromStream", 2, get_global_from_stream}};
+    imports_register(shims, sizeof shims / sizeof *shims);
+}
+void structured_storage_reset() {
+    // win32_init follows arena reset; clear host ownership without freeing
+    // addresses that may already have been reused by the fresh guest heap.
+    for (auto &entry : streams)
+        entry.second.bytes->delete_global = false;
+    storages.clear();
+    streams.clear();
+    storage_vtable = stream_vtable = 0;
+}
